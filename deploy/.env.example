# Settings for compose.yaml. install.sh writes .env from its arguments on
# every run, so change a setting by running it again rather than by editing
# .env. It reads only the CADDY_IMAGE and REGISTRY_IMAGE lines from this file;
# the rest shows what it writes.

# The console's domain (--domain). It must point at this machine: Caddy gets
# the HTTPS certificate for it from Let's Encrypt.
GAMEFLEET_DOMAIN=fleet.example.com
# Where Let's Encrypt sends notices about the certificate (--email).
ACME_EMAIL=ops@example.com
# The GameFleet image that runs: the release install.sh came from, or --image.
GAMEFLEET_IMAGE=ghcr.io/xuhuanhello/gamefleet:<version>
# Where the updater gets releases: it installs GAMEFLEET_IMAGE_REPO:<version>.
GAMEFLEET_IMAGE_REPO=ghcr.io/xuhuanhello/gamefleet
# The directory GameFleet shares with the updater, as the container sees it.
# Empty on a machine without systemd: there is no updater, so the console
# cannot update GameFleet; upgrade with install.sh instead.
GAMEFLEET_UPDATE_DIR=/var/lib/gamefleet-update
# Caddy and the image registry, pinned by digest. GameFleet releases move them.
CADDY_IMAGE=caddy:2@sha256:0c994536bddb66445885237f1a5dcc1916bccea922661c76b4e9fc24061f9b52
REGISTRY_IMAGE=registry:3@sha256:852b3e4d378c426dda6b318fe9d9bfe8e92a0eccb9926671ec3d3ea17a196696
